{
  "schemaVersion": 1,
  "id": "residuum",
  "version": "${version}",
  "name": "Residuum",
  "description": "What the weather and the world leave behind: windows fog and frost over, snow settles on ledges and drives onto walls in a blizzard, fire and explosions leave soot, arrows crack glass, feet leave prints in snow and sand, grass bends where you walk, and fireflies come out on mild nights. Client-side only.",
  "authors": [
    "w1z4r_d"
  ],
  "contact": {
    "homepage": "https://github.com/w133y/living-glass",
    "sources": "https://github.com/w133y/living-glass",
    "issues": "https://github.com/w133y/living-glass/issues"
  },
  "license": "MIT",
  "icon": "assets/residuum/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.w1z4r_d.residuum.ResiduumClient"
    ],
    "modmenu": [
      "com.w1z4r_d.residuum.ModMenuIntegration"
    ],
    "sodium:config_api_user": [
      ${sodium_entry}
    ]
  },
  "mixins": [
    "residuum.mixins.json",
    "residuum.compat.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19",
    "minecraft": "${mc_dep}",
    "java": ">=${java}",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  }
}
